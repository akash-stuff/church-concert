# ---------------------------------------------------------------------------
# Copy to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

APP_NAME="Grace Community Church"
APP_URL=http://localhost:3000
NODE_ENV=development
PORT=3000

# Set to 1 when running behind nginx / a load balancer so client IPs and
# secure cookies are handled correctly.
TRUST_PROXY=0

# ---------------------------------------------------------------------------
# Database — use the existing MySQL instance. Format:
#   mysql://user:password@host:3306/database
# URL-encode any special characters in the password (! # @ / : ? & % =).
# ---------------------------------------------------------------------------
DATABASE_URL=mysql://five2mysql:7Rehoboth77!gvcal@13.126.91.61:3306/church_concert
DB_POOL_LIMIT=10
DB_SSL=0

# ---------------------------------------------------------------------------
# Auth. Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ---------------------------------------------------------------------------
JWT_SECRET=rLg1XnIwNtmuh5yoUdHy89mVKXdD39bqQxHarSksh18Rtr2WzJ6Fz4DwEM7nVZUOE
JWT_EXPIRES_IN=12h
COOKIE_DOMAIN=

# ---------------------------------------------------------------------------
# Email. Driver options:
#   gmail — Gmail SMTP. Needs an App Password, not the account password.
#   smtp  — any other SMTP server; set SMTP_HOST / SMTP_PORT / SMTP_SECURE.
#   mock  — no network calls; messages are written to the server log and the
#           notifications table. Local development only.
#
# Email carries the verification code (alongside WhatsApp), booking
# confirmations, and password-reset links. Reset links go by email ONLY, so
# leaving this on `mock` in production means nobody can recover an account.
#
# Setting up Gmail:
#   1. Switch on 2-Step Verification for the account:
#      https://myaccount.google.com/signinoptions/two-step-verification
#   2. Create an App Password at https://myaccount.google.com/apppasswords
#      (choose "Mail" — it gives you 16 characters, spaces optional).
#   3. Put the address in EMAIL_USER and those 16 characters in EMAIL_PASSWORD.
#
# Google removed plain-password SMTP in 2022, so the account password will be
# rejected with 535-5.7.8 no matter how correct it looks.
#
# Limits worth knowing before a mail-out: a consumer gmail.com account is capped
# around 500 recipients a day, Google Workspace around 2,000. The event reminder
# sends one message per attendee, so a large concert can hit that ceiling — send
# it in batches, or use a transactional provider through the `smtp` driver.
#
# EMAIL_FROM must be the authenticated account or a verified alias; Gmail
# silently rewrites anything else. Left blank, it defaults to EMAIL_USER.
# ---------------------------------------------------------------------------
EMAIL_DRIVER=mock
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=
EMAIL_REPLY_TO=

# Only used by EMAIL_DRIVER=smtp. Gmail uses its own well-known settings.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true

# ---------------------------------------------------------------------------
# WhatsApp Business Cloud API (Meta). Driver options:
#   meta  — live sending through graph.facebook.com
#   mock  — no network calls; codes are written to the server log and the
#           notifications table. Use for local development only.
# ---------------------------------------------------------------------------
WHATSAPP_DRIVER=mock
WHATSAPP_API_URL=https://graph.facebook.com/v20.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=replace-with-a-random-webhook-verify-token
# Approved template names in WhatsApp Manager. Leave blank to send plain text
# (only works inside a 24h customer service window).
WHATSAPP_TEMPLATE_VERIFICATION=
WHATSAPP_TEMPLATE_BOOKING=
WHATSAPP_DEFAULT_COUNTRY_CODE=+91

# Verification code settings
OTP_LENGTH=6
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5

# ---------------------------------------------------------------------------
# Rate limiting, per IP per window. Raise RATE_LIMIT_AUTH_MAX if a group will
# register from one shared connection (church WiFi, carrier NAT), or those
# people will block each other. Verification codes are limited per account
# instead of per IP, for the same reason.
# ---------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_AUTH_MAX=40
RATE_LIMIT_API_MAX=300

# ---------------------------------------------------------------------------
# First admin, created by `npm run seed:admin`
# ---------------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@example.org
SEED_ADMIN_NAME=Concert Administrator
SEED_ADMIN_PASSWORD=
