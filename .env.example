# ---------------------------------------------------------------------------
# Copy to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

APP_NAME="Grace Community Church"
APP_URL=http://localhost:3000
NODE_ENV=development
PORT=3000

# Set to 1 when running behind nginx / a load balancer so client IPs and
# secure cookies are handled correctly.
TRUST_PROXY=0

# ---------------------------------------------------------------------------
# Database — use the existing MySQL instance. Format:
#   mysql://user:password@host:3306/database
# URL-encode any special characters in the password (! # @ / : ? & % =).
# ---------------------------------------------------------------------------
DATABASE_URL=mysql://user:password@127.0.0.1:3306/church_concert
DB_POOL_LIMIT=10
DB_SSL=0

# ---------------------------------------------------------------------------
# Auth. Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ---------------------------------------------------------------------------
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=12h
COOKIE_DOMAIN=

# ---------------------------------------------------------------------------
# WhatsApp Business Cloud API (Meta). Driver options:
#   meta  — live sending through graph.facebook.com
#   mock  — no network calls; codes are written to the server log and the
#           notifications table. Use for local development only.
# ---------------------------------------------------------------------------
WHATSAPP_DRIVER=mock
WHATSAPP_API_URL=https://graph.facebook.com/v20.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=replace-with-a-random-webhook-verify-token
# Approved template names in WhatsApp Manager. Leave blank to send plain text
# (only works inside a 24h customer service window).
WHATSAPP_TEMPLATE_VERIFICATION=
WHATSAPP_TEMPLATE_BOOKING=
WHATSAPP_DEFAULT_COUNTRY_CODE=+91

# Verification code settings
OTP_LENGTH=6
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5

# ---------------------------------------------------------------------------
# Rate limiting, per IP per window. Raise RATE_LIMIT_AUTH_MAX if a group will
# register from one shared connection (church WiFi, carrier NAT), or those
# people will block each other. Verification codes are limited per account
# instead of per IP, for the same reason.
# ---------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_AUTH_MAX=40
RATE_LIMIT_API_MAX=300

# ---------------------------------------------------------------------------
# First admin, created by `npm run seed:admin`
# ---------------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@example.org
SEED_ADMIN_NAME=Concert Administrator
SEED_ADMIN_PASSWORD=
